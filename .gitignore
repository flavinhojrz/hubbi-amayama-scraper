# Agent local/private state
# .claude/skills/** is versioned (Spec Kit generated skills) — everything else
# under .claude/ is treated as local/private agent state and ignored.
# Operational note: secrets must never be placed inside .claude/skills/**.
.claude/*
!.claude/skills/
!.claude/skills/**

# Codex local/private state
.codex/
.codex-local/

# Antigravity local/private state
.antigravity/
.antigravity-local/

# Scraper runtime data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Raw captures / benchmark artifacts
raw/
raw-*/
benchmark-*/
benchmark*.db
benchmark*.sqlite*
amayama-raw/
artifacts/

# Local browser/runtime
chrome-profile/
cdp-profile/